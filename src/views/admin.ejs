<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Admin - Manage Projects</title>
    <link rel="stylesheet" href="/public/css/style.css" />
  </head>
  <body>
    <header>
      <h1>Admin Panel</h1>
      <a class="btn" href="/">Back to Projects</a>
      <a class="btn" href="/logout">Logout</a>
    </header>

    <main>
      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <h2>Add New Project</h2>
      <form action="/admin/projects" method="POST" class="form">
        <label>Title<input type="text" name="title" value="<%= values.title || '' %>" required></label>
        <label>Description<textarea name="description"><%= values.description || '' %></textarea></label>
        <label>Tech<input type="text" name="tech" value="<%= values.tech || '' %>"></label>
        <label>Link<input type="url" name="link" value="<%= values.link || '' %>"></label>
        <button type="submit">Add Project</button>
      </form>

      <hr>

      <h2>Existing Projects</h2>
      <% if (projects && projects.length > 0) { %>
        <ul class="projects">
          <% projects.forEach(p => { %>
            <li>
              <h3><%= p.title %></h3>
              <p><%= p.description %></p>
              <% if (p.tech) { %><p><strong>Tech:</strong> <%= p.tech %></p><% } %>
              <% if (p.link) { %><a href="<%= p.link %>" target="_blank">View</a><br><% } %>

              <form action="/admin/projects/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this project?');">
                <button type="submit" class="delete-btn">Delete</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p>No projects yet.</p>
      <% } %>
    </main>
  </body>
</html>
